{
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh api *merge*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:refs/heads/main*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-protected-git.sh",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
