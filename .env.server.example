# Copy to .env on the server:  cp .env.server.example .env  — then fill in the three values.

# Your domain, without https:// or www (its DNS A record must point to this server)
DOMAIN=example.com

# Database password: any long random string (openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# Secret for logins: any long random string (openssl rand -hex 32)
PAYLOAD_SECRET=change-me
