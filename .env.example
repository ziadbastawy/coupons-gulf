# PostgreSQL connection (Neon, Supabase or local)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string, keep it secret (openssl rand -hex 32)
PAYLOAD_SECRET=change-me

# Public address of the site, no trailing slash. Used in canonical links, hreflang and the sitemap.
SITE_URL=https://www.example.com
